    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "^0.16.0",
    "p-limit": "^6.1.0",
    "turndown": "^7.2.0",
    "typebox": "^1.1.38",
    "undici": "^8.9.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
