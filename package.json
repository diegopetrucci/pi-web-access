{
  "name": "@diegopetrucci/pi-web-access",
  "version": "0.29.1",
  "description": "Web search and URL fetching for the tlh coding agent (Exa provider)",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc",
    "audit:runtime": "npm audit --omit=dev",
    "package:check": "node --test test/package-shape.test.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "fetch",
    "scraping"
  ],
  "author": "Nico Bailon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegopetrucci/pi-web-access.git"
  },
  "bugs": {
    "url": "https://github.com/diegopetrucci/pi-web-access/issues"
  },
  "homepage": "https://github.com/diegopetrucci/pi-web-access#readme",
  "files": [
    "activity.ts",
    "data-uri-sanitize.ts",
    "exa.ts",
    "extract.ts",
    "index.ts",
    "request-budget.ts",
    "rsc-extract.ts",
    "settings.ts",
    "ssrf-protection.ts",
    "storage.ts",
    "web-tools.ts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "NOTICE",
    "LICENSE"
